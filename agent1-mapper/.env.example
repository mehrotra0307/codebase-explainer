# ── Option A: Google AI (easiest for local dev) ────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_key_here

# ── Option B: Vertex AI via ADC (used on Cloud Run) ────────────────────────
# Run locally: gcloud auth application-default login
# Then set these:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ── Optional: raise GitHub rate limit from 60 to 5000 req/hr ───────────────
# Create a token at https://github.com/settings/tokens (no scopes needed for public repos)
# GITHUB_TOKEN=your_token_here

# ── Agent URLs (filled in after Phase 4 deployment) ────────────────────────
# AGENT2_URL=https://agent2-reader-xxxx-uc.a.run.app
# AGENT3_URL=https://agent3-explainer-xxxx-uc.a.run.app
